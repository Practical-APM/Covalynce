DATABASE_URL="postgresql://covalynce:covalynce_dev@localhost:5432/covalynce?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
# Sprint 1: Clerk
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# Encryption key for provider credentials (32+ chars)
CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-32-character-secret!!"
JWT_SECRET="change-me-jwt-secret-min-32-chars-long"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
# Sprint 5: rate limiting (per organization, authenticated requests)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Sprint 4: Alert notifications (optional — logs to console without these)
# RESEND_API_KEY=
# ALERT_FROM_EMAIL="alerts@covalynce.io"
# Provider OAuth (preferred connect — see INTEGRATIONS_STRATEGY.md)
# PROVIDER_OAUTH_MOCK_ENABLED=true
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_REDIRECT_URI=http://localhost:3000/providers/oauth/callback
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_CLIENT_SECRET=
# ANTHROPIC_OAUTH_REDIRECT_URI=http://localhost:3000/providers/oauth/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/providers/oauth/callback
# FRONTEND_URL=http://localhost:3000
# Product edition (self-host). Org plan in DB can also be set to enterprise.
# COVALYNCE_EDITION=community
# COVALYNCE_LICENSE_KEY=
# Sprint 18: Auth (see AUTH_THREAT_MODEL.md)
# SSO_MOCK_ENABLED=true
# AUTH_MODE=dev_passwordless
# AUTH_MODE=magic_link
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
