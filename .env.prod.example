# Copy to .env.prod and fill in secrets before running docker-compose.prod.yml

POSTGRES_USER=covalynce
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=covalynce

JWT_SECRET=change-me-jwt-secret-min-32-chars-long
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-32-character-secret!!

# Browser-facing API URL (must be reachable from user's machine)
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

API_PORT=3001
WEB_PORT=3000

# Auth mode: magic_link (recommended), dev_passwordless, or sso_required
AUTH_MODE=magic_link
# Browser-facing app URL, used in sign-in links and invite emails
FRONTEND_URL=http://localhost:3000

# Optional: rate limiting (requests per org per TTL window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Optional: email via Resend (also manageable later in Settings -> Self-host)
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=alerts@covalynce.io
